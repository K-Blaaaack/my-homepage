{
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "no-inline-style": "off",
    "valid-id": [
      "error",
      {
        "relaxed": true
      }
    ],
    "long-title": "off",
    "no-trailing-whitespace": "off",
    "attribute-boolean-style": "off",
    "void-style": "off",
    "no-implicit-button-type": "error",
    "require-sri": "off"
  }
}
